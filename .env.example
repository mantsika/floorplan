# =============================================================================
# FLOORPLAN — Environment variables
# R2 + D1 = Cloudflare Worker bindings in wrangler.jsonc (not .env)
# =============================================================================

# Pages frontend → Worker API URL
VITE_API_URL="https://floorplan-api.mantsika.workers.dev"

# OpenRouter — https://openrouter.ai/keys (works with any model prefix: sk-or-...)
OPENROUTER_API_KEY="sk-or-..."

# Optional default model (Worker var also set in wrangler.jsonc)
DEFAULT_EXTRACTION_MODEL="google/gemini-2.5-flash"
