# =============================================================================
# FLOORPLAN — Environment variables guide
# =============================================================================
#
# R2 and D1 do NOT use .env files. They are Cloudflare Worker BINDINGS
# configured in wrangler.jsonc and created via the Wrangler CLI.
#
# See CONFIG.md for the full setup checklist.
# =============================================================================

# --- Pages / frontend (required for R2 uploads + AI API calls) ---
# Point to your deployed Worker URL after: npm run deploy:api
VITE_API_URL="https://floorplan-api.YOUR_SUBDOMAIN.workers.dev"

# --- Local Express dev only (npm run dev) — NOT used on Cloudflare ---
GEMINI_API_KEY="AIzaSy..."
