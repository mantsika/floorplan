{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "floorplan-api",
  "account_id": "c1ac6faa0fcacb3cd335227a84c64699",
  "main": "src/worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PAGES_ORIGIN": "*",
    "DEFAULT_EXTRACTION_MODEL": "google/gemini-2.5-flash"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "floorplan"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "floorplan-db",
      "database_id": "61f3c5e9-a484-4cc2-b077-0eb91b188439",
      "migrations_dir": "migrations"
    }
  ]
}
